# Game images supplied by the player, and everything derived from them
/Games/
/Assets/
/Mods/

# Machine-specific configuration
/local.env
__pycache__/

# Unreal Engine generated content
/Binaries/
/Intermediate/
/Saved/
/DerivedDataCache/
/Plugins/**/Binaries/
/Plugins/**/Intermediate/
*_BuiltData.uasset

# Standalone build output, and what the engine writes into the project's Build folder; its icons are the project's own
/out/
/build/*
/Build/*
!/Build/Windows/
/Build/Windows/*
!/Build/Windows/Application.ico
!/Build/Android/
/Build/Android/*
!/Build/Android/res/

# IDE and generated project files
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# OS clutter
.DS_Store
Thumbs.db
